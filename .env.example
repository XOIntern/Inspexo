DB_PORT=5434
DB_USER=inspexo
DB_PASSWORD=inspexo
DB_NAME=inspexo
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5434/inspexo"
# v3.local PASERK (k3.local.… — 52 chars). Generate a dev-only key locally;
# never commit a real secret. Production uses its own key.
PASETO_SESSION_KEY="k3.local.REPLACE-WITH-GENERATED-PASERK"
# Resend API key for verification emails. Server-only: never expose to the
# client, never log. Dev uses Resend's onboarding sender, which delivers to
# the Resend account's own email only until a custom domain is verified.
RESEND_API_KEY=""